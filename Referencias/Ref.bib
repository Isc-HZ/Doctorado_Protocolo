@article{Li2026,
   abstract = {The widespread use of non-renewable energy sources (RESs) has resulted in serious environmental problems (e.g., global warming, the depletion of fossil fuels and glacier melting, etc.). As a carbon-free fuel, hydrogen (H2) represents one of the most promising energy carriers for future applications. It has a great potential to provide a power source for various energy devices (e.g., internal combustion engine (ICE), gas turbine (GT), fuel cell (FC), fuel cell electric vehicle (FCEV) and power systems, etc.). This review aims to synthesize the key technological advances in the hydrogen industry chain (HIC), including H2 production, purification, compression, transportation, storage and utilization, analyzing its industrialization status and future development trends. The main challenges faced with are also discussed in detail. Firstly, conventional and emerging green H2 production technologies are reviewed, with renewable energy hydrogen production offering certain environmental advantages and broad prospects. Secondly, a comprehensive comparison of purification methods is presented, with membrane separation technology being more attractive for hydrogen purification. Then, (non-) mechanical compression technologies designed specifically for H2 are explored. Among them, ionic liquid and linear compressors are more promising, while metal hydride compressors have unique advantages in purification and compression. In addition, the modern transportation and innovative storage methods of H2 are introduced. Finally, it provides an in-depth analysis of hydrogen energy future in transportation, aviation and power, offering valuable insights for promoting hydrogen energy. This review article possibly provides researchers and policymakers with a scientific, comprehensive and forward-looking reference for advancing the development of hydrogen energy.},
   author = {Quan Li and Qian Zhang and Lei Zhang and Jinhua Lang and Wei Yuan and Guangyao An and Tongtong Lei and JunhaoYan},
   doi = {10.1016/J.RSER.2025.116196},
   issn = {1364-0321},
   journal = {Renewable and Sustainable Energy Reviews},
   keywords = {Carbon peaking and carbon neutrality,Hydrogen,Hydrogen color,Industrial utilization,Renewable energy,Technology assessment},
   month = {1},
   pages = {116196},
   publisher = {Pergamon},
   title = {A comprehensive review of advances and challenges of hydrogen production, purification, compression, transportation, storage and utilization technology},
   volume = {226},
   url = {https://sciencedirect.bibliotecabuap.elogim.com/science/article/pii/S136403212500869X#bib61},
   year = {2026}
}